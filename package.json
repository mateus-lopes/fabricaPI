{
  "name": "censo-ifc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "dados:exemplo": "tsx scripts/gerar-dados-sinteticos.ts",
    "ci": "npm run typecheck && npm run test && npm run lint:deps"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "papaparse": "^5.7.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-echarts": "^8.3.2",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "dependency-cruiser": "^18.7.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.152.0"
  }
}
